# ==========================================
# Core Calculation Engine
# ==========================================
class PMDCMotorModel:
    """
    Permanent Magnet DC Motor Electromagnetic Model
    
    This class encapsulates all electromagnetic calculations for PMDC/BLDC motors,
    with emphasis on axial flux permanent magnet (AFPM) configurations.
    """
    
    def __init__(self, params: Dict):
        """
        Initialize motor model with design parameters.
        
        Parameters:
        -----------
        params : dict
            Dictionary containing all motor design parameters
        """
        self.params = params
        self.results: Optional[CalculationResults] = None
        self._validate_inputs()
        
    def _validate_inputs(self):
        """Validate input parameters for physical reasonableness"""
        p = self.params
        
        # Geometric constraints
        if p.get("D_out", 0) <= p.get("D_in", 0):
            raise ValueError("Outer diameter must be greater than inner diameter")
        
        if p.get("D_in", 0) <= 0:
            raise ValueError("Inner diameter must be positive")
            
        if p.get("h_mag", 0) <= 0:
            raise ValueError("Magnet thickness must be positive")
            
        if p.get("p", 0) < 1:
            raise ValueError("Pole pairs must be at least 1")
            
        # Magnetic constraints
        if not (0 < p.get("alpha_p", 0) <= 1):
            raise ValueError("Pole arc ratio must be between 0 and 1")
            
        if p.get("Br", 0) <= 0:
            raise ValueError("Remanent flux density must be positive")
    
    def calculate_magnetic_circuit(self) -> MagneticCircuit:
        """
        Calculate magnetic circuit parameters.
        
        Returns air gap flux density distribution and related parameters
        using reluctance network analysis.
        """
        p = self.params
        
        # Extract parameters
        D_o = p["D_out"] * 1e-3  # Convert to meters
        D_i = p["D_in"] * 1e-3
        h_m = p["h_mag"] * 1e-3
        h_c = p["h_coil"] * 1e-3
        g_s = p["g_side"] * 1e-3
        
        poles = int(p["p"])
        Br = p["Br"]
        alpha_p = p["alpha_p"]
        sigma_m = p.get("sigma_m", 1.15)  # Leakage factor
        mu_r_mag = p.get("mu_r_mag", 1.05)  # Relative permeability of magnet
        
        # Effective air gap (includes stator thickness for coreless design)
        g_eff = h_c + 2 * g_s
        
        # Average diameter and effective length
        D_avg = (D_o + D_i) / 2
        L_eff = (D_o - D_i) / 2
        
        # Pole area calculation
        # For AFPM: A_pole = (π/2p) * (R_o² - R_i²) * α_p
        A_pole = (PI / (2 * poles)) * ((D_o/2)**2 - (D_i/2)**2) * alpha_p
        
        # Carter coefficient for slotless design (≈1 for coreless stator)
        k_c = 1.0
        
        # Reluctance calculations
        # Air gap reluctance
        R_gap = (g_eff * k_c) / (MU0 * A_pole)
        
        # Magnet reluctance (considering both sides for dual-rotor)
        R_mag = (2 * h_m) / (MU0 * mu_r_mag * A_pole)
        
        # Magnet MMF source
        Fm = 2 * (Br / MU0) * h_m / mu_r_mag
        
        # Flux per pole (considering leakage)
        Phi_pole = Fm / (R_gap + sigma_m * R_mag)
        
        # Peak flux density in air gap
        Bg_peak = Phi_pole / A_pole
        
        # For trapezoidal distribution, average and RMS values
        # Assuming quasi-square wave with pole arc ratio
        Bg_avg = Bg_peak * alpha_p
        Bg_rms = Bg_peak * math.sqrt(alpha_p)
        
        # Permeance coefficient (operating point on B-H curve)
        PC = (h_m * 2) / (g_eff * sigma_m)
        
        return MagneticCircuit(
            Bg_peak=Bg_peak,
            Bg_avg=Bg_avg,
            Bg_rms=Bg_rms,
            Phi_pole=Phi_pole,
            PC=PC,
            R_gap=R_gap,
            R_mag=R_mag,
            Fm=Fm
        )
    
    def calculate_electrical_params(self, magnetic: MagneticCircuit) -> ElectricalParams:
        """
        Calculate electrical parameters including resistance, inductance, and EMF constants.
        """
        p = self.params
        
        # Extract parameters
        D_o = p["D_out"] * 1e-3
        D_i = p["D_in"] * 1e-3
        h_c = p["h_coil"] * 1e-3
        g_s = p["g_side"] * 1e-3
        
        poles = int(p["p"])
        N_ph = int(p["N_ph_turns"])
        d_wire = p["d_wire"] * 1e-3
        n_par = int(p["n_parallel"])
        k_w = p["k_w"]
        Temp = p["Temp_coil"]
        n_rated = p["n_rated"]
        waveform = p.get("waveform", "sinusoidal")
        
        D_avg = (D_o + D_i) / 2
        L_eff = (D_o - D_i) / 2
        
        # Electrical frequency
        f_el = n_rated * poles / 60
        omega_e = 2 * PI * f_el
        
        # --- Back EMF Calculation ---
        # For sinusoidal: E_ph = 4.44 * f * N * Φ * k_w
        # For trapezoidal: E_ph = 4 * f * N * Φ * k_w
        if waveform == "sinusoidal":
            E_ph_rms = 4.44 * f_el * N_ph * magnetic.Phi_pole * k_w
        else:  # trapezoidal
            E_ph_rms = 4.0 * f_el * N_ph * magnetic.Phi_pole * k_w
        
        E_line_rms = math.sqrt(3) * E_ph_rms
        
        # Back EMF constant (V/krpm for line-to-line)
        Ke = E_line_rms / (n_rated / 1000)
        
        # --- Torque Constant ---
        # Kt = 3 * E_ph / ω_m for 3-phase BLDC
        omega_m = n_rated * 2 * PI / 60
        Kt = (3 * E_ph_rms) / (math.sqrt(2) * omega_m)  # Nm/A_peak
        Kt_rms = Kt * math.sqrt(2)  # Nm/A_rms
        
        # --- Resistance Calculation ---
        # Pole pitch
        tau_p = PI * D_avg / (2 * poles)
        
        # Average turn length estimation
        # End turn length approximation for disc motor
        L_end = tau_p * 1.3  # End winding factor
        L_turn = 2 * L_eff + 2 * L_end
        
        # Total conductor length per phase
        L_total = L_turn * N_ph
        
        # Copper cross-sectional area
        A_cu = PI * (d_wire / 2)**2 * n_par
        
        # Temperature-adjusted resistivity
        rho = RHO_CU_20 * (1 + RHO_CU_TEMP_COEFF * (Temp - 20))
        
        # Phase and line resistance
        R_phase = rho * L_total / A_cu
        R_line = 2 * R_phase  # For Y-connection
        
        # --- Inductance Calculation ---
        # Air gap inductance (dominant for coreless design)
        # L_gap = μ0 * N² * A / g_eff
        g_eff = h_c + 2 * g_s
        A_coil = PI * ((D_o/2)**2 - (D_i/2)**2) / 6  # Per phase active area
        
        L_gap = MU0 * N_ph**2 * A_coil / g_eff
        
        # End winding inductance (empirical)
        L_end_ind = 0.15 * L_gap  # Typically 10-20% of gap inductance
        
        # Total phase inductance
        L_phase = L_gap + L_end_ind
        
        # Mutual inductance for 3-phase (typically -0.5 * L_self for balanced)
        M_mutual = -0.5 * L_phase * 0.3  # Reduced coupling in AFPM
        
        # Line inductance
        L_line = L_phase - M_mutual
        
        return ElectricalParams(
            R_phase=R_phase,
            R_line=R_line,
            L_phase=L_phase,
            L_line=L_line,
            M_mutual=M_mutual,
            E_phase_rms=E_ph_rms,
            E_line_rms=E_line_rms,
            Ke=Ke,
            Kt=Kt_rms
        )
    
    def calculate_losses(self, electrical: ElectricalParams, I_rms: float) -> Tuple[float, float, float, float]:
        """
        Calculate motor losses including copper, eddy current, core, and mechanical.
        """
        p = self.params
        
        D_o = p["D_out"] * 1e-3
        D_i = p["D_in"] * 1e-3
        d_wire = p["d_wire"] * 1e-3
        n_par = int(p["n_parallel"])
        N_ph = int(p["N_ph_turns"])
        n_rated = p["n_rated"]
        poles = int(p["p"])
        Temp = p["Temp_coil"]
        
        f_el = n_rated * poles / 60
        
        # --- Copper Loss ---
        P_cu = 3 * I_rms**2 * electrical.R_phase
        
        # --- Eddy Current Loss ---
        # Proximity effect in conductors
        # P_eddy ≈ (π²/6) * (f * B * d)² / ρ * V_cu
        rho = RHO_CU_20 * (1 + RHO_CU_TEMP_COEFF * (Temp - 20))
        
        # Estimate flux density seen by conductors
        Bg_local = p.get("Bg_peak", 0.5)  # Will be updated
        
        # Copper volume
        D_avg = (D_o + D_i) / 2
        tau_p = PI * D_avg / (2 * poles)
        L_eff = (D_o - D_i) / 2
        L_turn = 2 * L_eff + 2 * tau_p * 1.3
        A_cu = PI * (d_wire / 2)**2 * n_par
        V_cu = 3 * N_ph * L_turn * A_cu
        
        # Eddy current loss with skin effect consideration
        delta = math.sqrt(2 * rho / (MU0 * 2 * PI * f_el))  # Skin depth
        k_skin = 1.0 if d_wire < 2 * delta else (d_wire / (2 * delta))
        
        P_eddy = (PI**2 / 24) * (f_el * Bg_local * d_wire)**2 / rho * V_cu * k_skin
        
        # --- Core Loss ---
        # For coreless design, core loss is minimal (only in back iron if present)
        P_core = 0.01 * p["P_rated"]  # Nominal estimate
        
        # --- Mechanical Loss ---
        # Windage loss for disc rotor
        omega = n_rated * 2 * PI / 60
        Cm = 0.005  # Torque coefficient for enclosed disc
        P_windage = 0.5 * Cm * AIR_DENSITY * omega**3 * ((D_o/2)**5 - (D_i/2)**5) * 2
        
        # Bearing friction (empirical)
        P_bearing = 0.005 * p["P_rated"] * (n_rated / 3000)
        
        P_mech = P_windage + P_bearing
        
        return P_cu, P_eddy, P_core, P_mech
    
    def calculate_cogging_torque(self, magnetic: MagneticCircuit) -> Tuple[np.ndarray, np.ndarray]:
        """
        Estimate cogging torque using simplified analytical method.
        
        For slotless/coreless designs, cogging is minimal.
        This provides estimation for slotted stator designs.
        """
        p = self.params
        
        poles = int(p["p"]) * 2  # Total poles
        slots = int(p.get("slots", poles * 3))  # Default: 3 slots per pole
        
        # LCM determines cogging periods per revolution
        from math import gcd
        lcm = (poles * slots) // gcd(poles, slots)
        
        # Cogging torque angular positions
        theta = np.linspace(0, 2*PI, 360)
        
        # For coreless design, cogging is essentially zero
        if p.get("coreless", True):
            T_cog = np.zeros_like(theta)
            return theta, T_cog
        
        # Simplified cogging torque model for slotted stator
        # T_cog = T_cog_max * sin(lcm * θ)
        
        # Estimate peak cogging (typically 1-5% of rated torque)
        T_rated = 9.55 * p["P_rated"] / p["n_rated"]
        k_cog = p.get("k_cogging", 0.02)  # Cogging factor
        T_cog_peak = k_cog * T_rated
        
        # Include first few harmonics
        T_cog = T_cog_peak * (np.sin(lcm * theta) + 
                              0.3 * np.sin(2 * lcm * theta) +
                              0.1 * np.sin(3 * lcm * theta))
        
        return theta, T_cog
    
    def calculate_back_emf_waveform(self, magnetic: MagneticCircuit) -> Dict:
        """
        Generate back EMF waveforms for analysis and visualization.
        """
        p = self.params
        
        poles = int(p["p"])
        n_rated = p["n_rated"]
        N_ph = int(p["N_ph_turns"])
        k_w = p["k_w"]
        alpha_p = p["alpha_p"]
        waveform = p.get("waveform", "sinusoidal")
        
        # Time and angle arrays
        f_el = n_rated * poles / 60
        T_period = 1 / f_el
        t = np.linspace(0, 2 * T_period, 720)
        theta_e = 2 * PI * f_el * t  # Electrical angle
        theta_m = theta_e / poles     # Mechanical angle
        
        # Peak EMF calculation
        omega_e = 2 * PI * f_el
        E_peak = omega_e * N_ph * magnetic.Phi_pole * k_w
        
        if waveform == "sinusoidal":
            # Sinusoidal back EMF
            E_a = E_peak * np.sin(theta_e)
            E_b = E_peak * np.sin(theta_e - 2*PI/3)
            E_c = E_peak * np.sin(theta_e - 4*PI/3)
        else:
            # Trapezoidal back EMF
            E_a = self._trapezoidal_emf(theta_e, E_peak, alpha_p)
            E_b = self._trapezoidal_emf(theta_e - 2*PI/3, E_peak, alpha_p)
            E_c = self._trapezoidal_emf(theta_e - 4*PI/3, E_peak, alpha_p)
        
        # Line-to-line EMF
        E_ab = E_a - E_b
        E_bc = E_b - E_c
        E_ca = E_c - E_a
        
        # Ideal sinusoidal reference
        E_ideal = E_peak * np.sin(theta_e)
        
        return {
            "time": t,
            "theta_e": theta_e,
            "theta_m": np.degrees(theta_m),
            "E_a": E_a,
            "E_b": E_b,
            "E_c": E_c,
            "E_ab": E_ab,
            "E_bc": E_bc,
            "E_ca": E_ca,
            "E_ideal": E_ideal,
            "E_peak": E_peak,
            "E_rms": E_peak / math.sqrt(2)
        }
    
    def _trapezoidal_emf(self, theta: np.ndarray, E_peak: float, alpha_p: float) -> np.ndarray:
        """Generate trapezoidal back EMF waveform."""
        theta = np.mod(theta, 2*PI)
        E = np.zeros_like(theta)
        
        # Flat top duration (in radians)
        flat_angle = PI * alpha_p
        rise_angle = PI * (1 - alpha_p) / 2
        
        for i, th in enumerate(theta):
            th_mod = th % (2*PI)
            if th_mod < rise_angle:
                E[i] = E_peak * th_mod / rise_angle
            elif th_mod < rise_angle + flat_angle:
                E[i] = E_peak
            elif th_mod < PI:
                E[i] = E_peak * (PI - th_mod) / rise_angle
            elif th_mod < PI + rise_angle:
                E[i] = -E_peak * (th_mod - PI) / rise_angle
            elif th_mod < PI + rise_angle + flat_angle:
                E[i] = -E_peak
            else:
                E[i] = -E_peak * (2*PI - th_mod) / rise_angle
        
        return E
    
    def calculate_torque_waveform(self, electrical: ElectricalParams) -> Dict:
        """
        Calculate instantaneous torque waveform including ripple.
        """
        p = self.params
        
        poles = int(p["p"])
        n_rated = p["n_rated"]
        P_out = p["P_rated"]
        
        # Rated torque
        T_rated = 9.55 * P_out / n_rated
        
        # Electrical angle
        theta_e = np.linspace(0, 4*PI, 720)  # Two electrical cycles
        
        # Average torque
        T_avg = T_rated
        
        # Torque ripple components (simplified model)
        # 6th harmonic dominant for 3-phase BLDC
        k_6 = p.get("k_ripple_6", 0.05)  # 5% 6th harmonic
        k_12 = p.get("k_ripple_12", 0.02)  # 2% 12th harmonic
        
        T_ripple = k_6 * np.cos(6 * theta_e) + k_12 * np.cos(12 * theta_e)
        
        T_inst = T_avg * (1 + T_ripple)
        
        # Torque ripple percentage
        T_ripple_pct = (np.max(T_inst) - np.min(T_inst)) / T_avg * 100
        
        return {
            "theta_e": np.degrees(theta_e),
            "T_inst": T_inst,
            "T_avg": T_avg,
            "T_ripple_pct": T_ripple_pct,
            "T_max": np.max(T_inst),
            "T_min": np.min(T_inst)
        }
    
    def calculate_flux_distribution(self, magnetic: MagneticCircuit) -> Dict:
        """
        Calculate air gap flux density distribution vs. mechanical angle.
        """
        p = self.params
        
        poles = int(p["p"]) * 2
        alpha_p = p["alpha_p"]
        
        # Mechanical angle (one revolution)
        theta_m = np.linspace(0, 360, 720)
        theta_m_rad = np.radians(theta_m)
        
        # Pole pitch in degrees
        pole_pitch = 360 / poles
        
        # Generate quasi-square wave flux density
        Bg = np.zeros_like(theta_m)
        
        for i, th in enumerate(theta_m):
            # Position within pole pair
            th_pole = th % (2 * pole_pitch)
            
            if th_pole < pole_pitch * alpha_p:
                Bg[i] = magnetic.Bg_peak
            elif th_pole < pole_pitch:
                Bg[i] = 0
            elif th_pole < pole_pitch * (1 + alpha_p):
                Bg[i] = -magnetic.Bg_peak
            else:
                Bg[i] = 0
        
        # Calculate statistics
        Bg_avg = np.mean(np.abs(Bg))
        Bg_rms = np.sqrt(np.mean(Bg**2))
        
        # FFT analysis
        Bg_fft = np.fft.fft(Bg)
        freqs = np.fft.fftfreq(len(Bg), 1/720)
        Bg_spectrum = np.abs(Bg_fft[:len(Bg)//2]) / len(Bg) * 2
        harmonics = np.arange(len(Bg_spectrum)) * poles / 2
        
        return {
            "theta_m": theta_m,
            "Bg": Bg,
            "Bg_peak": magnetic.Bg_peak,
            "Bg_avg": Bg_avg,
            "Bg_rms": Bg_rms,
            "harmonics": harmonics[:50],
            "spectrum": Bg_spectrum[:50]
        }
    
    def run_full_analysis(self) -> CalculationResults:
        """
        Execute complete electromagnetic analysis.
        """
        p = self.params
        
        # Create geometry object
        geometry = MotorGeometry(
            D_out=p["D_out"] * 1e-3,
            D_in=p["D_in"] * 1e-3,
            h_mag=p["h_mag"] * 1e-3,
            h_coil=p["h_coil"] * 1e-3,
            g_side=p["g_side"] * 1e-3
        )
        
        # Magnetic circuit analysis
        magnetic = self.calculate_magnetic_circuit()
        
        # Update Bg_peak for loss calculation
        p["Bg_peak"] = magnetic.Bg_peak
        
        # Electrical parameters
        electrical = self.calculate_electrical_params(magnetic)
        
        # Calculate rated current
        T_rated = 9.55 * p["P_rated"] / p["n_rated"]
        I_rms = T_rated / electrical.Kt
        
        # Calculate losses
        P_cu, P_eddy, P_core, P_mech = self.calculate_losses(electrical, I_rms)
        
        # Total losses and efficiency
        P_loss = P_cu + P_eddy + P_core + P_mech
        P_in = p["P_rated"] + P_loss
        Efficiency = p["P_rated"] / P_in * 100
        
        # Voltage requirement
        V_res = I_rms * electrical.R_line
        V_ind = 2 * PI * (p["n_rated"] * int(p["p"]) / 60) * electrical.L_line * I_rms
        V_req = math.sqrt(electrical.E_line_rms**2 + V_res**2 + V_ind**2) * 1.05
        V_margin = (p["V_dc"] - V_req) / p["V_dc"] * 100
        
        # Fill factor calculation
        D_o, D_i = p["D_out"] * 1e-3, p["D_in"] * 1e-3
        d_wire = p["d_wire"] * 1e-3
        n_par = int(p["n_parallel"])
        N_ph = int(p["N_ph_turns"])
        
        # Inner diameter fill factor (critical constraint)
        K_fill = (3 * N_ph * 2 * n_par * d_wire) / (PI * D_i)
        
        # Current density
        A_cu = PI * (d_wire / 2)**2 * n_par
        J = I_rms / (A_cu * 1e6)  # A/mm²
        
        # Torque analysis
        torque_data = self.calculate_torque_waveform(electrical)
        theta_cog, T_cog = self.calculate_cogging_torque(magnetic)
        
        # Performance metrics
        performance = PerformanceMetrics(
            T_rated=T_rated,
            T_avg=torque_data["T_avg"],
            T_ripple=torque_data["T_ripple_pct"],
            T_cogging_peak=np.max(np.abs(T_cog)),
            I_phase_rms=I_rms,
            I_line_rms=I_rms,  # Same for Y-connection
            J_current=J,
            P_out=p["P_rated"],
            P_in=P_in,
            P_cu=P_cu,
            P_eddy=P_eddy,
            P_mech=P_mech,
            P_core=P_core,
            Efficiency=Efficiency,
            V_required=V_req,
            V_margin=V_margin,
            K_fill=K_fill
        )
        
        # Waveform data
        waveforms = {
            "back_emf": self.calculate_back_emf_waveform(magnetic),
            "torque": torque_data,
            "flux": self.calculate_flux_distribution(magnetic),
            "cogging": {"theta": theta_cog, "T_cog": T_cog}
        }
        
        # Metadata
        metadata = {
            "calculation_time": datetime.now().isoformat(),
            "model_version": "5.0",
            "waveform_type": p.get("waveform", "sinusoidal")
        }
        
        self.results = CalculationResults(
            geometry=geometry,
            magnetic=magnetic,
            electrical=electrical,
            performance=performance,
            waveforms=waveforms,
            metadata=metadata
        )
        
        return self.results


