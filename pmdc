    def run_optimization(self):
        """Run automated design optimization"""
        try:
            params = self._get_params()
            
            self.result_text.delete(1.0, tk.END)
            self.result_text.insert(tk.END, "=" * 60 + "\n")
            self.result_text.insert(tk.END, "   AUTOMATED DESIGN OPTIMIZATION\n")
            self.result_text.insert(tk.END, "=" * 60 + "\n\n")
            self.result_text.insert(tk.END, "Searching for optimal configuration...\n\n")
            self.root.update()
            
            best_score = -float('inf')
            best_params = None
            best_results = None
            
            target_V = params["V_dc"] * 0.85  # Target 85% voltage utilization
            
            optimization_log = []
            
            # Optimization loop: vary turns and parallel conductors
            for N_try in range(15, 120, 3):
                params["N_ph_turns"] = N_try
                
                # First pass to estimate current
                params["n_parallel"] = 1
                try:
                    model = PMDCMotorModel(params)
                    temp_results = model.run_full_analysis()
                except:
                    continue
                
                I_est = temp_results.performance.I_phase_rms
                
                # Calculate required parallel conductors for J ≈ 5 A/mm²
                d_wire = params["d_wire"] * 1e-3
                A_single = PI * (d_wire/2)**2 * 1e6  # mm²
                n_par_needed = max(1, round(I_est / (5.5 * A_single)))
                n_par_needed = min(n_par_needed, 10)  # Practical limit
                
                params["n_parallel"] = n_par_needed
                
                # Full calculation with adjusted parameters
                try:
                    model = PMDCMotorModel(params)
                    results = model.run_full_analysis()
                except:
                    continue
                
                # Scoring function
                score = 0
                perf = results.performance
                
                # Hard constraints (heavy penalties)
                if perf.V_required > params["V_dc"]:
                    score -= 10000
                if perf.K_fill > params["fill_limit"]:
                    score -= 5000
                if perf.J_current > 8:
                    score -= 2000
                elif perf.J_current > 6:
                    score -= 500
                
                # Soft objectives
                score += perf.Efficiency * 10  # Maximize efficiency
                score -= abs(target_V - perf.V_required) * 2  # Voltage utilization
                score -= perf.T_ripple * 10  # Minimize torque ripple
                
                optimization_log.append({
                    "N": N_try,
                    "n_par": n_par_needed,
                    "V_req": perf.V_required,
                    "J": perf.J_current,
                    "Eff": perf.Efficiency,
                    "K_fill": perf.K_fill,
                    "Score": score
                })
                
                if score > best_score:
                    best_score = score
                    best_params = params.copy()
                    best_results = results
            
            if best_results:
                # Update input fields with optimal values
                self.vars["N_ph_turns"].set(str(int(best_params["N_ph_turns"])))
                self.vars["n_parallel"].set(str(int(best_params["n_parallel"])))
                
                self.calc_results = best_results
                
                # Display optimization results
                self.result_text.insert(tk.END, "OPTIMIZATION COMPLETE!\n")
                self.result_text.insert(tk.END, "-" * 50 + "\n\n")
                self.result_text.insert(tk.END, "Recommended Design Parameters:\n")
                self.result_text.insert(tk.END, f"  • Turns per Phase: {int(best_params['N_ph_turns'])}\n")
                self.result_text.insert(tk.END, f"  • Parallel Conductors: {int(best_params['n_parallel'])}\n\n")
                
                perf = best_results.performance
                self.result_text.insert(tk.END, "Optimized Performance:\n")
                self.result_text.insert(tk.END, f"  • Efficiency: {perf.Efficiency:.2f}%\n")
                self.result_text.insert(tk.END, f"  • Voltage Margin: {perf.V_margin:.1f}%\n")
                self.result_text.insert(tk.END, f"  • Current Density: {perf.J_current:.2f} A/mm²\n")
                self.result_text.insert(tk.END, f"  • Fill Factor: {perf.K_fill:.3f}\n")
                self.result_text.insert(tk.END, f"  • Torque Ripple: {perf.T_ripple:.2f}%\n\n")
                
                # Display full report
                self._display_report()
                self._plot_performance_curves()
                self._plot_back_emf()
                self._plot_torque()
                self._plot_flux_distribution()
                self._draw_geometry()
                
            else:
                self.result_text.insert(tk.END, "OPTIMIZATION FAILED\n")
                self.result_text.insert(tk.END, "Could not find feasible design point.\n")
                self.result_text.insert(tk.END, "Please check geometric constraints.\n")
                
        except Exception as e:
            messagebox.showerror("Optimization Error", f"Optimization failed:\n{str(e)}")
    
    def export_json(self):
        """Export calculation data to JSON file"""
        if not self.calc_results:
            messagebox.showwarning("No Data", "Please run analysis first.")
            return
            
        filepath = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")],
            title="Save Calculation Data"
        )
        
        if filepath:
            data = {
                "input_parameters": self._get_params(),
                "results": self.calc_results.to_dict(),
                "waveforms": {
                    "back_emf": {k: v.tolist() if isinstance(v, np.ndarray) else v 
                                for k, v in self.calc_results.waveforms.get("back_emf", {}).items()},
                    "torque": {k: v.tolist() if isinstance(v, np.ndarray) else v 
                              for k, v in self.calc_results.waveforms.get("torque", {}).items()},
                    "flux": {k: v.tolist() if isinstance(v, np.ndarray) else v 
                            for k, v in self.calc_results.waveforms.get("flux", {}).items()}
                }
            }
            
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
                
            messagebox.showinfo("Export Complete", f"Data saved to:\n{filepath}")
    
    def export_csv(self):
        """Export calculation data to CSV file"""
        if not self.calc_results:
            messagebox.showwarning("No Data", "Please run analysis first.")
            return
            
        filepath = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv"), ("All files", "*.*")],
            title="Save Calculation Data"
        )
        
        if filepath:
            r = self.calc_results
            p = self._get_params()
            
            with open(filepath, 'w', newline='', encoding='utf-8') as f:
                writer = csv.writer(f)
                
                # Header
                writer.writerow(["PMDC Motor Calculation Results"])
                writer.writerow(["Generated", datetime.now().isoformat()])
                writer.writerow([])
                
                # Input parameters
                writer.writerow(["Input Parameters"])
                for key, value in p.items():
                    writer.writerow([key, value])
                writer.writerow([])
                
                # Magnetic circuit
                writer.writerow(["Magnetic Circuit Results"])
                writer.writerow(["Bg_peak (T)", r.magnetic.Bg_peak])
                writer.writerow(["Bg_avg (T)", r.magnetic.Bg_avg])
                writer.writerow(["Phi_pole (Wb)", r.magnetic.Phi_pole])
                writer.writerow(["PC", r.magnetic.PC])
                writer.writerow([])
                
                # Electrical parameters
                writer.writerow(["Electrical Parameters"])
                writer.writerow(["R_phase (Ω)", r.electrical.R_phase])
                writer.writerow(["L_phase (H)", r.electrical.L_phase])
                writer.writerow(["Ke (V/krpm)", r.electrical.Ke])
                writer.writerow(["Kt (Nm/A)", r.electrical.Kt])
                writer.writerow([])
                
                # Performance
                writer.writerow(["Performance Metrics"])
                writer.writerow(["Efficiency (%)", r.performance.Efficiency])
                writer.writerow(["T_rated (Nm)", r.performance.T_rated])
                writer.writerow(["I_phase (A)", r.performance.I_phase_rms])
                writer.writerow(["J (A/mm²)", r.performance.J_current])
                writer.writerow(["P_cu (W)", r.performance.P_cu])
                writer.writerow(["P_eddy (W)", r.performance.P_eddy])
                
            messagebox.showinfo("Export Complete", f"Data saved to:\n{filepath}")
    
