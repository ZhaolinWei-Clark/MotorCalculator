    def _check_design_validity(self, r: CalculationResults) -> List[str]:
        """Check design for potential issues"""
        warnings = []
        perf = r.performance
        
        if perf.J_current > 10:
            warnings.append("⚠️ CRITICAL: Current density extremely high (>10 A/mm²) - Risk of thermal failure!")
        elif perf.J_current > 6:
            warnings.append("⚠️ WARNING: Current density high (>6 A/mm²) - Forced cooling required")
        
        if perf.V_margin < 5:
            warnings.append("⚠️ WARNING: Voltage margin insufficient (<5%) - Dynamic response limited")
        elif perf.V_margin > 40:
            warnings.append("ℹ️ INFO: Large voltage margin (>40%) - Consider increasing turns")
        
        if perf.K_fill > 0.8:
            warnings.append("⚠️ CRITICAL: Fill factor exceeds practical limit (>0.8) - Design not manufacturable!")
        elif perf.K_fill > 0.6:
            warnings.append("⚠️ WARNING: Fill factor high (>0.6) - Manufacturing difficulty expected")
        
        if perf.Efficiency < 85:
            warnings.append("ℹ️ INFO: Efficiency below 85% - Consider design optimization")
            
        if r.magnetic.Bg_peak > 1.0:
            warnings.append("⚠️ WARNING: High air gap flux density - Verify magnet operating point")
            
        return warnings
    
    def _plot_performance_curves(self):
        """Plot speed-torque and efficiency curves"""
        for widget in self.curves_tab.winfo_children():
            widget.destroy()
            
        if not self.calc_results:
            return
            
        r = self.calc_results
        p = self._get_params()
        
        fig = Figure(figsize=(12, 8), dpi=100)
        
        # Create 2x2 subplot grid
        gs = GridSpec(2, 2, figure=fig, hspace=0.3, wspace=0.3)
        
        # Generate operating range data
        T_max = r.performance.T_rated * 2.5
        torques = np.linspace(0.01, T_max, 100)
        
        speeds = []
        efficiencies = []
        currents = []
        powers_out = []
        
        V_dc = p["V_dc"]
        Ke = r.electrical.Ke
        Kt = r.electrical.Kt
        R_line = r.electrical.R_line
        
        for T in torques:
            I = T / Kt
            V_drop = I * R_line
            E_req = V_dc - V_drop
            n = max(0, E_req / (Ke / 1000))
            
            P_out = T * n * 2 * PI / 60
            P_cu = 3 * I**2 * r.electrical.R_phase
            P_mech = r.performance.P_mech * (n / p["n_rated"])**2 if n > 0 else 0
            P_in = P_out + P_cu + P_mech + r.performance.P_eddy
            
            eff = (P_out / P_in * 100) if P_in > 0 else 0
            
            speeds.append(n)
            efficiencies.append(eff)
            currents.append(I)
            powers_out.append(P_out)
        
        # Plot 1: Speed-Torque Characteristic
        ax1 = fig.add_subplot(gs[0, 0])
        ax1.plot(torques, speeds, 'b-', linewidth=2, label='Speed')
        ax1.axhline(y=p["n_rated"], color='b', linestyle='--', alpha=0.5, label=f'Rated: {p["n_rated"]} rpm')
        ax1.axvline(x=r.performance.T_rated, color='r', linestyle='--', alpha=0.5, label=f'Rated: {r.performance.T_rated:.2f} Nm')
        ax1.set_xlabel('Torque (Nm)', fontsize=10)
        ax1.set_ylabel('Speed (rpm)', fontsize=10, color='b')
        ax1.set_title('Speed-Torque Characteristic', fontsize=11, fontweight='bold')
        ax1.grid(True, alpha=0.3)
        ax1.legend(loc='upper right', fontsize=8)
        ax1.set_xlim(0, T_max)
        ax1.set_ylim(0, None)
        
        # Plot 2: Efficiency Map
        ax2 = fig.add_subplot(gs[0, 1])
        ax2.plot(torques, efficiencies, 'g-', linewidth=2)
        ax2.axhline(y=r.performance.Efficiency, color='g', linestyle='--', alpha=0.5, 
                   label=f'Rated: {r.performance.Efficiency:.1f}%')
        ax2.set_xlabel('Torque (Nm)', fontsize=10)
        ax2.set_ylabel('Efficiency (%)', fontsize=10, color='g')
        ax2.set_title('Efficiency vs. Torque', fontsize=11, fontweight='bold')
        ax2.grid(True, alpha=0.3)
        ax2.legend(loc='lower right', fontsize=8)
        ax2.set_xlim(0, T_max)
        ax2.set_ylim(0, 100)
        
        # Plot 3: Current vs. Torque
        ax3 = fig.add_subplot(gs[1, 0])
        ax3.plot(torques, currents, 'r-', linewidth=2)
        ax3.axhline(y=r.performance.I_phase_rms, color='r', linestyle='--', alpha=0.5,
                   label=f'Rated: {r.performance.I_phase_rms:.1f} A')
        ax3.set_xlabel('Torque (Nm)', fontsize=10)
        ax3.set_ylabel('Phase Current (A)', fontsize=10, color='r')
        ax3.set_title('Current vs. Torque (Linear Relationship)', fontsize=11, fontweight='bold')
        ax3.grid(True, alpha=0.3)
        ax3.legend(loc='upper left', fontsize=8)
        ax3.set_xlim(0, T_max)
        
        # Plot 4: Output Power
        ax4 = fig.add_subplot(gs[1, 1])
        ax4.plot(torques, powers_out, 'm-', linewidth=2)
        ax4.axhline(y=p["P_rated"], color='m', linestyle='--', alpha=0.5,
