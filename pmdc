@dataclass
class MotorGeometry:
    """Motor geometric parameters"""
    D_out: float  # Outer diameter (m)
    D_in: float   # Inner diameter (m)
    h_mag: float  # Magnet thickness (m)
    h_coil: float # Stator disc thickness (m)
    g_side: float # Single-side mechanical air gap (m)
    
    @property
    def D_avg(self) -> float:
        return (self.D_out + self.D_in) / 2
    
    @property
    def L_eff(self) -> float:
        return (self.D_out - self.D_in) / 2
    
    @property
    def g_eff(self) -> float:
        return self.h_coil + 2 * self.g_side
    
    @property
    def active_area(self) -> float:
        return PI * (self.D_out**2 - self.D_in**2) / 4


@dataclass
class MagneticCircuit:
    """Magnetic circuit calculation results"""
    Bg_peak: float      # Peak air gap flux density (T)
