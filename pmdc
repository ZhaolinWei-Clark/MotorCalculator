            self._plot_performance_curves()
            self._plot_back_emf()
            self._plot_torque()
            self._plot_flux_distribution()
            self._draw_geometry()
            
            # Switch to report tab
            self.notebook.select(0)
            
        except Exception as e:
            messagebox.showerror("Analysis Error", f"Calculation failed:\n{str(e)}")
            raise
            
