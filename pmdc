        ax4.set_xlabel('Torque (Nm)', fontsize=10)
        ax4.set_ylabel('Output Power (W)', fontsize=10, color='m')
        ax4.set_title('Power Output vs. Torque', fontsize=11, fontweight='bold')
        ax4.grid(True, alpha=0.3)
        ax4.legend(loc='upper right', fontsize=8)
