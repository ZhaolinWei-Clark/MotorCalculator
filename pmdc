    def _get_params(self) -> Dict:
        """Collect all parameters from input fields"""
        params = {}
        for key, var in self.vars.items():
            try:
                val = var.get()
                # Try to convert to number
                if '.' in val:
                    params[key] = float(val)
                else:
                    try:
                        params[key] = int(val)
                    except ValueError:
                        params[key] = val
            except:
                params[key] = 0.0
                
        params["coreless"] = self.coreless_var.get()
        return params
    
    def run_analysis(self):
        """Execute full electromagnetic analysis"""
        try:
            params = self._get_params()
            
            # Create motor model
            model = PMDCMotorModel(params)
            
            # Run analysis
            self.calc_results = model.run_full_analysis()
            
            # Store in history
            self.calculation_history.append({
                "timestamp": datetime.now().isoformat(),
                "params": params,
                "results": self.calc_results.to_dict()
            })
            
            # Update displays
